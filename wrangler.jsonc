{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vrunda-beauty-parlour",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "./public"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beauty-parlour-db",
